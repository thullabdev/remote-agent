# Copy to ~/.config/remote-agent/env (chmod 600). Never commit real values.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Private supergroup with Topics enabled (negative, starts with -100)
TELEGRAM_CHAT_ID=-1001234567890
# Your own Telegram user id
TELEGRAM_ALLOWED_USER_ID=123456789
# Channels to run, comma list of web and telegram (default web). Telegram vars above are required only with telegram.
REMOTE_AGENT_CHANNELS=telegram
# Port for the web channel on 127.0.0.1 (default 8787)
# REMOTE_AGENT_WEB_PORT=8787
# Tailscale login allowed to use the web channel (required with web), e.g. alice@example.com
# REMOTE_AGENT_WEB_ALLOWED_LOGIN=you@example.com
# Comma list of allowed Origin hosts for the web channel (required with web), e.g. box.tail1234.ts.net
# REMOTE_AGENT_WEB_ORIGINS=box.tail1234.ts.net
# Optional bearer token for web access not going through tailscale serve
# REMOTE_AGENT_WEB_TOKEN=replace-me
# Optional directory of built web UI files to serve, with SPA fallback
# REMOTE_AGENT_WEB_STATIC=/home/you/Sites/remote-agent-web/ui/dist
# VAPID subject for Web Push, a mailto: or https: URL (default mailto:remote-agent@localhost)
# REMOTE_AGENT_VAPID_SUBJECT=mailto:you@example.com
# Optional overrides
# REMOTE_AGENT_SOCKET=/run/user/1000/remote-agent/bridge.sock
# REMOTE_AGENT_DB=/home/you/.local/state/remote-agent/bridge.db
# REMOTE_AGENT_REMINDER_MINUTES=30
